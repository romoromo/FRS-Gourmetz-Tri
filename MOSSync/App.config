    <add key="UnzippedFolder" value="Sync\Zipped"/>
    <add key="DestinationFolder" value="\FRS\Resources\Orders\Cancellation"/>
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2"/>
    </startup>
