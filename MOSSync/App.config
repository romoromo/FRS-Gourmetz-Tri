<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ZipApiUrl" value=""/>
    <add key="DownloadUrl" value=""/>
    <add key="MOS_ZipResourceFilePath" value="\FRS\Resources\Sync\Unzip"/>
    <add key="MOS_UnzipResourceFilePath" value="FRS\Resources\Orders\ToCopy"/>
    <add key="RelativePath" value="Orders\\Cancellation"/>
    <add key="Filename" value="CancelledOrders"/>
    <add key="SyncType" value="Date"/>
