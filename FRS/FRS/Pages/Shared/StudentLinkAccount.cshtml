@model StudentLinkAccountModel
@{
    //Layout = "_Layout";
    ViewData["Title"] = "Account Creation";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <!-- Add Bootstrap CSS -->
    @* <link href="~/styles.css" /> *@
    <link href="~/webadmin/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">

        <div class="row justify-content-center">
            <h1>Account Creation</h1>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-4">
                <form asp-action="StudentLinkAccount">
                    <div asp-validation-summary="All" class="text-danger" style="color:red"></div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="FullName" class="control-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="color:red"></span>
                    </div>
                    <input type="hidden" asp-for="StudentId" class="form-control" />
                    <div class="form-group">
                        <input type="submit" value="Submit" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

